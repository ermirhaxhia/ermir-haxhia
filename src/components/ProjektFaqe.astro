---
// Faqja e një projekti me aplikacion Shiny (design/pages/Projekt.dc.html).
// Përdoret nga /fletorja/shkolle/[slug] (publike) dhe /p/[kodi] (e fshehur).
import Base from '../layouts/Base.astro';
import Sheet from './Sheet.astro';
import Vlera from './Vlera.astro';

interface Props {
  title: string;
  noindex?: boolean;
  /** Skeda "← Shkollë" sipër fletës. Te faqet e fshehura mungon (pa lidhje drejt faqeve publike). */
  kthehu?: { href: string; label: string };
  etiketa?: string;
  titulli: string;
  pershkrimi: string | null;
  shinyUrl: string | null;
  raportiUrl: string | null;
  /** Vlera e fushës "Linku për ndarje" (vetëm faqet publike). */
  linkuNdarje?: string | null;
  /** Faqe e fshehur: linku për ndarje është adresa e kësaj faqeje. */
  fshehur?: boolean;
}
const { title, noindex, kthehu, etiketa, titulli, pershkrimi, shinyUrl, raportiUrl, linkuNdarje, fshehur } = Astro.props;
---
<Base title={title} noindex={noindex}>
  <div class="wrap">
    <div class="inner">
      {kthehu && (
        <nav class="kthehu" aria-label="Kthehu">
          <a href={kthehu.href}>
            <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
            {kthehu.label}
          </a>
        </nav>
      )}
      <Sheet>
        <section class="koka">
          {etiketa && <div class="etiketa">{etiketa}</div>}
          <h1>{titulli}</h1>
          <p class="pershkrimi"><Vlera v={pershkrimi} /></p>
        </section>

        <section class="bllok">
          <div class="titull"><span class="nr">01</span><h2>Aplikacioni</h2></div>
          <div class="dritare">
            <div class="shiriti">
              <div class="pika" aria-hidden="true"><span></span><span></span><span></span></div>
              <div class="adresa"><Vlera v={shinyUrl} /></div>
            </div>
            {shinyUrl ? (
              <iframe src={shinyUrl} title={`Aplikacioni Shiny: ${titulli}`} loading="lazy"></iframe>
            ) : (
              <div class="bosh-app">
                <svg aria-hidden="true" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#5A6072" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="14" rx="2" /><path d="M8 21h8M12 18v3" /></svg>
                <div class="bosh-titull">Këtu hapet Shiny app</div>
                <div class="bosh-tekst">Aplikacioni ekzekutohet në serverin e vet. Faqja vetëm e shfaq brenda fletores, pa e ndarë kodin.</div>
                <div class="bosh-tekst"><strong>Aplikacioni do të shtohet.</strong></div>
              </div>
            )}
          </div>
          <div class="butona">
            {shinyUrl ? (
              <a class="btn i-erret" href={shinyUrl}>Hap në faqe të plotë <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9" /></svg></a>
            ) : (
              <span class="btn i-erret joaktiv" aria-disabled="true">Hap në faqe të plotë</span>
            )}
            {raportiUrl ? (
              <a class="btn kontur" href={raportiUrl}>Raporti në R (PDF)</a>
            ) : (
              <span class="btn kontur joaktiv" aria-disabled="true">Raporti në R (PDF)</span>
            )}
          </div>
        </section>

        <section class="bllok">
          <div class="titull"><span class="nr">02</span><h2>Linku për ndarje</h2></div>
          {fshehur && <p class="tekst">Kjo faqe është e fshehur. Kush ka linkun e hap direkt, pa llogari dhe pa kod.</p>}
          <div class="linku">
            <div class="kuti" data-link data-live={fshehur ? '' : undefined}>
              {fshehur ? <Fragment>[ ... ]</Fragment> : <Vlera v={linkuNdarje ?? null} />}
            </div>
            <button type="button" data-kopjo disabled={!fshehur && !linkuNdarje}>Kopjo linkun</button>
            <span class="sr-only" role="status" data-status></span>
          </div>
          {fshehur && <div class="shenim">pa listë, pa menu — vetëm ai që e ka linkun.</div>}
        </section>
      </Sheet>
    </div>
  </div>
</Base>

<script>
  // Vetëm "Kopjo linkun". Te faqet e fshehura linku është adresa e faqes aktuale.
  const kuti = document.querySelector<HTMLElement>('[data-link]');
  const buton = document.querySelector<HTMLButtonElement>('[data-kopjo]');
  const status = document.querySelector<HTMLElement>('[data-status]');
  if (kuti && buton) {
    if (kuti.hasAttribute('data-live')) {
      kuti.textContent = location.href;
      buton.disabled = false;
    }
    buton.addEventListener('click', async () => {
      const tekst = kuti.textContent?.trim() ?? '';
      try {
        await navigator.clipboard.writeText(tekst);
        buton.textContent = 'U kopjua';
        if (status) status.textContent = 'Linku u kopjua';
      } catch {
        buton.textContent = 'Kopjoje me dorë';
      }
      setTimeout(() => { buton.textContent = 'Kopjo linkun'; }, 2000);
    });
  }
</script>

<style>
  .wrap { padding: 32px clamp(12px, 3vw, 32px) 64px; display: flex; flex-direction: column; align-items: center; }
  .inner { width: 100%; max-width: 1040px; display: flex; flex-direction: column; }

  .kthehu { display: flex; padding-left: var(--margin-x); }
  .kthehu a {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 18px; font-family: var(--font-mono);
    font-size: 13px; text-decoration: none; background: var(--color-paper); border: 1px solid var(--color-border);
    border-bottom: none; border-radius: 10px 10px 0 0; position: relative; top: 1px;
  }

  .koka { display: flex; flex-direction: column; }
  .etiketa { font-family: var(--font-mono); font-size: 13px; line-height: 32px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-muted); }
  h1 { margin: 0; font-size: clamp(32px, 4.6vw, 44px); line-height: 64px; font-weight: 650; letter-spacing: -0.025em; }
  .pershkrimi { margin: 0; max-width: 600px; font-size: 18px; line-height: 32px; text-wrap: pretty; }

  .bllok { display: flex; flex-direction: column; margin-top: 64px; }
  .titull { display: flex; align-items: baseline; gap: 16px; line-height: 64px; }
  .nr { font-family: var(--font-mono); font-size: 13px; color: var(--color-accent); }
  h2 { margin: 0; font-size: 28px; line-height: 64px; font-weight: 650; letter-spacing: -0.02em; }

  .dritare {
    width: 100%; max-width: 820px; background: #fff; border: 1px solid #B9B4A8; border-radius: 10px;
    overflow: hidden; box-shadow: 0 10px 24px -16px rgba(30, 34, 48, 0.4);
  }
  .shiriti { display: flex; align-items: center; gap: 12px; padding: 10px 14px; background: var(--color-tab-idle); border-bottom: 1px solid var(--color-border); }
  .pika { display: flex; gap: 6px; flex: none; }
  .pika span { width: 10px; height: 10px; border-radius: 50%; background: var(--color-border); }
  .adresa {
    flex: 1 1 auto; min-width: 0; padding: 4px 12px; background: #fff; border: 1px solid var(--color-border); border-radius: 6px;
    font-family: var(--font-mono); font-size: 12px; line-height: 20px; color: var(--color-muted-strong);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  iframe { display: block; width: 100%; height: 720px; border: 0; background: #fff; }
  .bosh-app {
    min-height: 420px; padding: 32px; display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 12px; text-align: center; background-color: #FAFAF6; background-image: radial-gradient(#D9DEE8 1px, transparent 1px); background-size: 20px 20px;
  }
  .bosh-titull { font-size: 16px; line-height: 24px; font-weight: 600; }
  .bosh-tekst { max-width: 360px; font-size: 14px; line-height: 22px; color: var(--color-muted-strong); text-wrap: pretty; }

  .butona { margin-top: 32px; display: flex; flex-wrap: wrap; gap: 12px; }
  .btn {
    display: inline-flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 20px; border-radius: 8px;
    font-size: 15px; font-weight: 500; text-decoration: none;
  }
  .btn.i-erret { background: var(--color-ink); color: var(--color-paper); }
  .btn.i-erret:hover { color: var(--color-paper); }
  .btn.kontur { border: 1px solid var(--color-ink); }
  .btn.joaktiv { opacity: 0.55; cursor: not-allowed; }

  .tekst { margin: 0; max-width: 560px; font-size: 16px; line-height: 32px; text-wrap: pretty; }
  .linku { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; min-height: 64px; }
  .kuti {
    padding: 0 16px; min-height: 44px; display: inline-flex; align-items: center; background: var(--color-paper-warm);
    border: 1.5px dashed var(--color-dashed); border-radius: 6px; font-family: var(--font-mono); font-size: 14px; overflow-wrap: anywhere;
  }
  button {
    min-height: 44px; padding: 0 18px; background: transparent; border: 1px solid var(--color-ink); border-radius: 8px;
    font-family: var(--font-sans); font-size: 14px; font-weight: 500; color: var(--color-ink); cursor: pointer;
  }
  button:disabled { opacity: 0.55; cursor: not-allowed; }
  .shenim { margin-top: 32px; font-family: var(--font-hand); font-size: 24px; line-height: 32px; color: var(--color-accent); }
</style>
