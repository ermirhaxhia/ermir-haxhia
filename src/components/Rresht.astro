---
// Rresht i listës: data, titulli, përshkrimi, statusi (Projekte, Shkollë).
// Me `href` i gjithë rreshti është lidhje: titulli merr vijën e verdhë dhe statusi shigjetën.
import Vlera from './Vlera.astro';
import Shigjeta from './Shigjeta.astro';

interface Props {
  data: string | null;
  titulli: string | null;
  pershkrimi: string | null;
  statusi?: string | null;
  href?: string | null;
}
const { data, titulli, pershkrimi, statusi, href } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag class:list={['rresht', { lidhje: !!href }]} href={href ?? undefined}>
  <span class="data"><Vlera v={data} /></span>
  <div class="trupi">
    <div class="titulli"><Vlera v={titulli} /></div>
    <div class="pershkrimi"><Vlera v={pershkrimi} /></div>
  </div>
  {statusi !== undefined && (
    <span class="statusi"><Vlera v={statusi} />{href && <Shigjeta />}</span>
  )}
</Tag>

<style>
  .rresht { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 0 24px; min-height: 64px; text-decoration: none; color: inherit; }
  .data { flex: 0 0 112px; font-family: var(--font-mono); font-size: 13px; line-height: 32px; color: var(--color-muted); }
  .trupi { flex: 1 1 260px; min-width: 0; }
  .titulli { font-size: 18px; line-height: 32px; font-weight: 600; }
  .lidhje .titulli {
    text-decoration: underline; text-decoration-color: var(--color-highlight); text-decoration-thickness: 6px;
    text-underline-offset: -2px; text-decoration-skip-ink: none;
  }
  .pershkrimi { font-size: 15px; line-height: 32px; color: var(--color-muted); }
  .statusi {
    display: inline-flex; align-items: center; gap: 8px; margin-top: 6px; font-family: var(--font-mono);
    font-size: 12px; line-height: 20px; padding: 0 10px; border: 1px solid var(--color-muted); border-radius: 999px;
    color: var(--color-muted-strong);
  }
  .lidhje .statusi { border-color: var(--color-accent); color: var(--color-accent); }
</style>
