---
// Skedat sipër fletës (Ballina, Projekte, Shkollë, Kontakt) + lidhja "Kryefaqja".
interface Props {
  current?: string;
}
const { current } = Astro.props;
const tabs = [
  { href: '/fletorja', label: 'Ballina' },
  { href: '/fletorja/projekte', label: 'Projekte' },
  { href: '/fletorja/shkolle', label: 'Shkollë' },
  { href: '/fletorja/kontakt', label: 'Kontakt' },
];
---
<nav class="tabs" aria-label="Faqet">
  {tabs.map((t) => (
    <a href={t.href} class:list={['tab', { active: current === t.href }]} aria-current={current === t.href ? 'page' : undefined}>
      {t.label}
    </a>
  ))}
  <a href="/" class="home">
    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
    Kryefaqja
  </a>
</nav>

<style>
  .tabs { display: flex; flex-wrap: wrap; gap: 6px; padding-left: var(--margin-x); }
  .tab {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px;
    font-family: var(--font-mono); font-size: 13px; text-decoration: none;
    border: 1px solid var(--color-border); border-bottom: none; border-radius: 10px 10px 0 0;
    color: var(--color-muted-strong); background: var(--color-tab-idle);
  }
  .tab.active { color: var(--color-ink); background: var(--color-paper); position: relative; top: 1px; }
  .home {
    margin-left: auto; align-self: center; display: inline-flex; align-items: center; gap: 8px;
    min-height: 44px; font-family: var(--font-mono); font-size: 13px; text-decoration: none;
    color: var(--color-muted-strong);
  }
</style>
