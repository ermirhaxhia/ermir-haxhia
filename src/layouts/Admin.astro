---
// Guaska e panelit /admin. Pa fonte të jashtme dhe pa JavaScript (CSP e kufizon).
import { entitetet } from '../lib/admin-config';

interface Props {
  titulli: string;
  aktiv?: string;
}
const { titulli, aktiv } = Astro.props;
const grupet = [...new Set(entitetet.map((e) => e.grupi))];
const email = Astro.locals.admin?.email;
---
<!doctype html>
<html lang="sq">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{titulli} — Paneli</title>
  </head>
  <body>
    <header class="krye">
      <a class="logo" href="/admin">Paneli</a>
      <nav aria-label="Seksionet">
        {grupet.map((g) => (
          <div class="grupi">
            <span class="grupi-emri">{g}</span>
            {entitetet.filter((e) => e.grupi === g).map((e) => (
              <a href={`/admin/${e.id}`} aria-current={aktiv === e.id ? 'page' : undefined}>{e.titulli}</a>
            ))}
          </div>
        ))}
        <div class="grupi">
          <span class="grupi-emri">Skedarët</span>
          <a href="/admin/skedaret" aria-current={aktiv === 'skedaret' ? 'page' : undefined}>Foto dhe PDF</a>
        </div>
      </nav>
      <div class="djathtas">
        {email && <span class="email">{email}</span>}
        <a href="/" target="_blank" rel="noopener">Hap faqen ↗</a>
      </div>
    </header>
    <main><slot /></main>
  </body>
</html>

<style is:global>
  :root { color-scheme: light; }
  body { margin: 0; font-family: system-ui, -apple-system, 'Segoe UI', sans-serif; color: #1E2230; background: #F4F2EC; line-height: 1.5; }
  a { color: #2F4FA3; }
  .krye { background: #1E2230; color: #F3F1EA; padding: 12px 20px; display: flex; flex-wrap: wrap; gap: 12px 28px; align-items: flex-start; }
  .krye a { color: #F3F1EA; text-decoration: none; display: inline-flex; align-items: center; min-height: 36px; padding: 0 8px; border-radius: 6px; }
  .krye a:hover, .krye a[aria-current='page'] { background: #353C57; }
  .logo { font-weight: 700; font-size: 18px; }
  .krye nav { display: flex; flex-wrap: wrap; gap: 8px 22px; flex: 1 1 520px; min-width: 0; }
  .grupi { display: flex; flex-direction: column; }
  .grupi-emri { font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: #A9B0C4; padding: 0 8px; }
  .djathtas { display: flex; flex-direction: column; align-items: flex-end; font-size: 14px; margin-left: auto; }
  .email { color: #A9B0C4; font-size: 12px; }
  main { max-width: 1040px; margin: 0 auto; padding: 28px 20px 80px; }
  h1 { margin: 0 0 4px; font-size: 28px; }
  .shpjegim { margin: 0 0 20px; color: #4A5062; max-width: 70ch; }
  .mesazh { padding: 12px 16px; border-radius: 8px; margin: 16px 0; }
  .mesazh.ok { background: #E3F0E6; border: 1px solid #8DB79A; }
  .mesazh.gabim { background: #FBE6E6; border: 1px solid #D98C8C; }
  .karte { background: #fff; border: 1px solid #D9D5CB; border-radius: 10px; padding: 16px; margin: 0 0 14px; }
  .rrjeta { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px 16px; }
  .fusha { display: flex; flex-direction: column; gap: 4px; font-size: 14px; }
  .fusha > span { font-weight: 600; font-size: 13px; color: #353C57; }
  .fusha input[type='text'], .fusha textarea, .fusha select, .fusha input[type='file'] {
    font: inherit; padding: 9px 10px; min-height: 44px; border: 1px solid #B9B4A8; border-radius: 6px; background: #fff; width: 100%; box-sizing: border-box;
  }
  .fusha textarea { min-height: 96px; resize: vertical; }
  .fusha input:focus-visible, .fusha textarea:focus-visible, .fusha select:focus-visible, .btn:focus-visible { outline: 3px solid #2F4FA3; outline-offset: 2px; }
  .po-jo { flex-direction: row; align-items: center; gap: 10px; min-height: 44px; }
  .po-jo input { width: 20px; height: 20px; }
  .veprime { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 14px; }
  .btn { font: inherit; font-weight: 600; min-height: 44px; padding: 0 18px; border-radius: 8px; border: 1px solid #1E2230; background: #fff; color: #1E2230; cursor: pointer; }
  .btn.kryesor { background: #1E2230; color: #fff; }
  .btn.i-vogel { min-width: 44px; padding: 0 12px; }
  .btn.rrezik { border-color: #B33A3A; color: #B33A3A; }
  .btn.rrezik.i-plote { background: #B33A3A; color: #fff; }
  details.fshi > summary { list-style: none; cursor: pointer; display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px; border: 1px solid #B33A3A; color: #B33A3A; border-radius: 8px; font-weight: 600; }
  details.fshi > summary::-webkit-details-marker { display: none; }
  details.fshi[open] > summary { display: none; }
  details.fshi .konfirmo { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .lexim { font-size: 13px; color: #4A5062; word-break: break-all; }
  h2 { font-size: 20px; margin: 32px 0 12px; }
  .bosh { color: #4A5062; }
  .kartat { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; }
  .kartat a { display: block; background: #fff; border: 1px solid #D9D5CB; border-radius: 10px; padding: 14px 16px; text-decoration: none; color: inherit; }
  .kartat a:hover { border-color: #2F4FA3; }
  .kartat strong { display: block; }
  .kartat span { font-size: 13px; color: #4A5062; }
  table { width: 100%; border-collapse: collapse; background: #fff; border: 1px solid #D9D5CB; border-radius: 10px; overflow: hidden; }
  th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid #ECE9E1; font-size: 14px; vertical-align: middle; }
  th { background: #F4F2EC; font-size: 12px; letter-spacing: 0.05em; text-transform: uppercase; color: #4A5062; }
  .kopje-url { font-family: ui-monospace, Consolas, monospace; font-size: 12px; word-break: break-all; }
</style>
