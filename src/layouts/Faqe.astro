---
// Layout pa skeda (Dosja, Libraria, faqet e fshehura): vetëm lidhja "Kryefaqja" dhe fleta.
import Base from './Base.astro';
import Sheet from '../components/Sheet.astro';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
const { title, description, noindex } = Astro.props;
---
<Base title={title} description={description} noindex={noindex}>
  <div class="wrap">
    <div class="inner">
      <a href="/" class="home">
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
        Kryefaqja
      </a>
      <Sheet><slot /></Sheet>
    </div>
  </div>
</Base>

<style>
  .wrap { padding: 32px clamp(12px, 3vw, 32px) 64px; display: flex; flex-direction: column; align-items: center; }
  .inner { width: 100%; max-width: 1040px; display: flex; flex-direction: column; }
  .home {
    align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; min-height: 44px;
    padding-left: var(--margin-x); font-family: var(--font-mono); font-size: 13px;
    text-decoration: none; color: var(--color-muted-strong);
  }
</style>
