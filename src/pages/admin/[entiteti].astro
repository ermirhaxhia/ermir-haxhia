---
// Faqja e përgjithshme e panelit: lista + formularët e një entiteti (shih lib/admin-config.ts).
import Admin from '../../layouts/Admin.astro';
import AdminFusha from '../../components/AdminFusha.astro';
import { entitetSipasId, permbledhjaERreshtit } from '../../lib/admin-config';
import {
  lexoRreshtat, opsioneBurimi, lexoFushat, lexoCelesin, shto, ruaj, fshi, leviz, listoSkedaret,
  type Perfundim,
} from '../../lib/admin';
import { urlSkedari } from '../../lib/files';

const e = entitetSipasId(Astro.params.entiteti ?? '');
if (!e) return new Response('Nuk u gjet', { status: 404 });
const baza = `/admin/${e.id}`;

const MESAZHET: Record<string, string> = {
  shtuar: 'U shtua me sukses.', ruajtur: 'U ruajt. Ndryshimi është tashmë në faqe.', fshire: 'U fshi.', levizur: 'Rendi u ndryshua.',
};

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const veprimi = String(f.get('_veprimi') ?? '');
  let rez: Perfundim = { ok: false, gabim: 'Veprim i panjohur.' };
  let mesazhi = '';
  const celesi = lexoCelesin(e, f.get('_celesi'));

  if (veprimi === 'shto') {
    const v = lexoFushat(e, f, { shtim: true });
    rez = v.ok ? await shto(e, v.vlerat) : v;
    mesazhi = 'shtuar';
  } else if (veprimi === 'ruaj' && celesi !== null) {
    const v = lexoFushat(e, f, { shtim: false });
    rez = v.ok ? await ruaj(e, celesi, v.vlerat) : v;
    mesazhi = 'ruajtur';
  } else if (veprimi === 'fshi' && celesi !== null) {
    rez = await fshi(e, celesi);
    mesazhi = 'fshire';
  } else if ((veprimi === 'lart' || veprimi === 'poshte') && celesi !== null) {
    rez = await leviz(e, celesi, veprimi);
    mesazhi = 'levizur';
  }
  // Rreshti i prekur mbetet i hapur pas ridrejtimit.
  const hap = celesi !== null && veprimi !== 'fshi' ? `&h=${encodeURIComponent(String(celesi))}#n${encodeURIComponent(String(celesi))}` : '';
  const q = rez.ok ? `?m=${mesazhi}${hap}` : `?g=${encodeURIComponent(rez.gabim.slice(0, 200))}${hap}`;
  return Astro.redirect(baza + q, 303);
}

const m = MESAZHET[Astro.url.searchParams.get('m') ?? ''];
const g = Astro.url.searchParams.get('g')?.slice(0, 200);
const hapur = Astro.url.searchParams.get('h');

const rreshtat = await lexoRreshtat(e);
const opsioneTeBurimit: Record<string, { vlera: string; etiketa: string }[]> = {};
for (const f of e.fushat) if (f.lloji === 'burim') opsioneTeBurimit[f.emri] = await opsioneBurimi(f);
const kaSkedar = e.fushat.some((f) => f.lloji === 'skedar');
const skedaret = kaSkedar ? await listoSkedaret() : [];
const celesiIRreshtit = (r: Record<string, string | number | null>) => String(r[e.celesi]);
// Sa fusha (që nuk janë kuti zgjedhjeje) janë ende bosh në këtë rresht.
const boshe = (r: Record<string, string | number | null>) =>
  e.fushat.filter((f) => f.lloji !== 'poJo' && !f.vetemShtim && (r[f.emri] === null || r[f.emri] === '')).length;
const hapTeGjitha = rreshtat.length <= 3;
---
<Admin titulli={e.titulli} aktiv={e.id}>
  <h1>{e.titulli}</h1>
  {e.pershkrimi && <p class="shpjegim">{e.pershkrimi}</p>}
  {e.faqja && <p><a class="btn" href={e.faqja} target="_blank" rel="noopener">Shiko në faqe ↗</a></p>}
  {m && <div class="mesazh ok" role="status">{m}</div>}
  {g && <div class="mesazh gabim" role="alert">{g}</div>}

  {kaSkedar && (
    <datalist id="skedaret-e-ngarkuar">
      {skedaret.map((s) => <option value={urlSkedari(s.celesi)} />)}
    </datalist>
  )}

  {e.njeRresht ? (
    rreshtat.map((r, i) => (
      <form method="post" class="karte">
        <input type="hidden" name="_celesi" value={celesiIRreshtit(r)} />
        <div class="rrjeta">
          {e.fushat.map((f) => (
            <AdminFusha f={f} vlera={r[f.emri]} opsione={opsioneTeBurimit[f.emri]} vetemLexim={!!f.vetemShtim} idPrefix={`r${i}`} />
          ))}
        </div>
        <div class="veprime"><button class="btn kryesor" type="submit" name="_veprimi" value="ruaj">Ruaj ndryshimet</button></div>
      </form>
    ))
  ) : (
    <>
      <details class="shto" open={rreshtat.length === 0}>
        <summary>＋ Shto {e.njesia ?? 'rresht'} të ri</summary>
        <form method="post" class="karte">
          <div class="rrjeta">
            {e.fushat.map((f) => (
              <AdminFusha f={f} vlera="" opsione={opsioneTeBurimit[f.emri]} idPrefix="re" />
            ))}
          </div>
          <div class="veprime"><button class="btn kryesor" type="submit" name="_veprimi" value="shto">Shto</button></div>
        </form>
      </details>

      {rreshtat.length === 0 && <p class="bosh-tekst">{e.boshTekst ?? 'Ende nuk ka asnjë rresht. Shto të parin më sipër.'}</p>}

      {rreshtat.map((r, i) => {
        const titulli = permbledhjaERreshtit(e, r);
        const nBosh = boshe(r);
        return (
          <details class="njesi" id={`n${celesiIRreshtit(r)}`} open={hapTeGjitha || hapur === celesiIRreshtit(r)}>
            <summary>
              <span class="nr" aria-hidden="true">{i + 1}</span>
              <span class:list={['titulli-njesise', { bosh: !titulli }]}>{titulli ?? '(ende pa titull)'}</span>
              {nBosh > 0
                ? <span class="shenja">{nBosh} {nBosh === 1 ? 'fushë bosh' : 'fusha bosh'}</span>
                : <span class="shenja mire">e plotësuar</span>}
              <span class="shigjeta" aria-hidden="true">▾</span>
            </summary>
            <form method="post">
              <input type="hidden" name="_celesi" value={celesiIRreshtit(r)} />
              <div class="rrjeta">
                {e.fushat.map((f) => (
                  <AdminFusha f={f} vlera={r[f.emri]} opsione={opsioneTeBurimit[f.emri]} vetemLexim={!!f.vetemShtim} idPrefix={`r${i}`} />
                ))}
              </div>
              {e.gjeneroKod && (
                <p class="lexim">Linku për ta ndarë: <a href={`/p/${r.kodi}`} target="_blank" rel="noopener">/p/{r.kodi}</a></p>
              )}
              <div class="veprime">
                <button class="btn kryesor" type="submit" name="_veprimi" value="ruaj">Ruaj ndryshimet</button>
                {e.renditja && (
                  <>
                    <button class="btn i-vogel" type="submit" name="_veprimi" value="lart" aria-label="Zhvendose lart" title="Lart">↑</button>
                    <button class="btn i-vogel" type="submit" name="_veprimi" value="poshte" aria-label="Zhvendose poshtë" title="Poshtë">↓</button>
                  </>
                )}
                <details class="fshi">
                  <summary>Fshi</summary>
                  <div class="konfirmo">
                    <span>Je i sigurt? Nuk kthehet prapa.</span>
                    <button class="btn rrezik" type="submit" name="_veprimi" value="fshi">Po, fshije</button>
                  </div>
                </details>
              </div>
            </form>
          </details>
        );
      })}
    </>
  )}
</Admin>
