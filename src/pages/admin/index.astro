---
import Admin from '../../layouts/Admin.astro';
import { entitetet } from '../../lib/admin-config';
import { numrat } from '../../lib/admin';

const numrat_ = await numrat(entitetet);
const grupet = [...new Set(entitetet.map((e) => e.grupi))];
---
<Admin titulli="Ballina">
  <h1>Paneli i faqes</h1>
  <p class="shpjegim">Zgjidh çfarë do të ndryshosh. Ndryshimet shfaqen menjëherë në faqen publike. Nuk ka kthim prapa: nëse fshin diçka, humbet.</p>

  {grupet.map((g) => (
    <section>
      <h2>{g}</h2>
      <div class="kartat">
        {entitetet.filter((e) => e.grupi === g).map((e) => (
          <a href={`/admin/${e.id}`}>
            <strong>{e.titulli}</strong>
            <span>{e.njeRresht ? 'ndrysho' : `${numrat_[e.id]} rreshta`}</span>
          </a>
        ))}
      </div>
    </section>
  ))}
  <section>
    <h2>Skedarët</h2>
    <div class="kartat"><a href="/admin/skedaret"><strong>Foto dhe PDF</strong><span>ngarko, shiko, fshi</span></a></div>
  </section>
</Admin>
