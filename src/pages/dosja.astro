---
// Dosja e analizave (design/pages/Dosja.dc.html): skeda kraft, fletë me kuadrate, kartela me pamje.
import Base from '../layouts/Base.astro';
import Vlera from '../components/Vlera.astro';
import { getDosja } from '../lib/db';

const dosjaPunet = await getDosja();

const nr = (i: number) => String(i + 1).padStart(2, '0');
---
<Base title="Dosja e analizave — Ermir Haxhia" description="Dashboard-e në Power BI, modele në Excel dhe analiza të dhënash.">
  <div class="wrap">
    <div class="inner">
      <nav class="skedat" aria-label="Dosja">
        <a href="/" class="skeda">
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
          Kryefaqja
        </a>
        {dosjaPunet.seksionet.map((s) => <a href={`#${s.id}`} class="skeda">{s.titulli}</a>)}
      </nav>
      <main>
        <svg class="kapse" aria-hidden="true" width="26" height="44" viewBox="0 0 26 44" fill="none" stroke="#5A6072" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 34V9a5 5 0 0 1 10 0v26a8 8 0 0 1-16 0V12" /></svg>
        <section class="koka">
          <div class="etiketa">Dosja · Nr. 02</div>
          <h1>Dosja e <span class="hl">analizave</span></h1>
          <p class="hyrje">Dashboard-e në Power BI, modele në Excel dhe analiza të dhënash. Çdo punë ka pamjen e vet, burimin e të dhënave dhe përfundimin.</p>
        </section>

        {dosjaPunet.seksionet.map((s, i) => (
          <section id={s.id} class="seksion">
            <div class="titull"><span class="nr">{nr(i)}</span><h2>{s.titulli}</h2></div>
            <div class="rrjeta">
              {s.punet.map((p) => (
                <article class="karte">
                  <div class="pamje">
                    {p.pamje
                      ? <img src={p.pamje} alt={p.titulli ?? ''} loading="lazy" />
                      : <span><Vlera v={null} /> pamje e punës</span>}
                  </div>
                  <div class="meta">
                    <span class="pilule">{s.mjeti}</span>
                    <span class="data"><Vlera v={p.data} /></span>
                  </div>
                  <h3><Vlera v={p.titulli} href={p.url} /></h3>
                  <p><Vlera v={p.pershkrimi} /></p>
                </article>
              ))}
            </div>
          </section>
        ))}
      </main>
    </div>
  </div>
</Base>

<style>
  html { scroll-behavior: smooth; }
  .wrap { padding: 32px clamp(12px, 3vw, 32px) 64px; display: flex; flex-direction: column; align-items: center; }
  .inner { width: 100%; max-width: 1040px; display: flex; flex-direction: column; }

  .skedat { display: flex; flex-wrap: wrap; gap: 6px; align-items: flex-end; }
  .skeda {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 18px; font-family: var(--font-mono);
    font-size: 13px; text-decoration: none; border: 1px solid #A98A57; border-bottom: none; border-radius: 10px 10px 0 0;
    background: #D9BE8E; color: var(--color-kraft-ink);
  }
  .skeda:hover { color: var(--color-kraft-ink); background: #E3CDA3; }

  main {
    position: relative; background-color: var(--color-paper);
    background-image: linear-gradient(var(--color-grid) 1px, transparent 1px), linear-gradient(90deg, var(--color-grid) 1px, transparent 1px);
    background-size: 24px 24px; border: 1px solid #A98A57; border-top: 3px solid #A98A57; border-radius: 0 12px 12px 12px;
    box-shadow: 0 18px 40px -24px rgba(30, 34, 48, 0.35); padding: 56px clamp(20px, 5vw, 64px) 72px;
  }
  .kapse { position: absolute; top: -20px; right: clamp(24px, 6vw, 72px); }

  .koka { display: flex; flex-direction: column; gap: 8px; }
  .etiketa { font-family: var(--font-mono); font-size: 13px; line-height: 32px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-muted); }
  h1 { margin: 0; font-size: clamp(34px, 5vw, 48px); line-height: 1.15; font-weight: 650; letter-spacing: -0.025em; }
  .hl { background: linear-gradient(transparent 58%, var(--color-highlight) 58%); }
  .hyrje { margin: 0; max-width: 580px; font-size: 18px; line-height: 30px; text-wrap: pretty; }

  .seksion { display: flex; flex-direction: column; margin-top: 64px; gap: 24px; scroll-margin-top: 16px; }
  .titull { display: flex; align-items: baseline; gap: 16px; }
  .nr { font-family: var(--font-mono); font-size: 13px; color: var(--color-accent); }
  h2 { margin: 0; font-size: 28px; line-height: 40px; font-weight: 650; letter-spacing: -0.02em; }

  .rrjeta { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); gap: 24px; }
  .karte {
    background: #fff; border: 1px solid var(--color-border); border-radius: 4px; padding: 16px;
    box-shadow: 0 10px 20px -16px rgba(30, 34, 48, 0.45); display: flex; flex-direction: column; gap: 12px; min-width: 0;
  }
  .pamje {
    aspect-ratio: 16 / 10; background-color: #FAFAF6; background-image: radial-gradient(#D9DEE8 1px, transparent 1px);
    background-size: 16px 16px; border: 1.5px dashed #9AA0B0; border-radius: 3px; display: flex; align-items: center;
    justify-content: center; font-family: var(--font-mono); font-size: 12px; color: var(--color-muted); overflow: hidden;
  }
  .pamje img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .meta { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .pilule { font-family: var(--font-mono); font-size: 12px; line-height: 20px; padding: 0 10px; border: 1px solid var(--color-muted); border-radius: 999px; color: var(--color-muted-strong); }
  .data { font-family: var(--font-mono); font-size: 12px; color: var(--color-muted); }
  h3 { margin: 0; font-size: 18px; line-height: 26px; font-weight: 600; }
  p { margin: 0; font-size: 15px; line-height: 24px; color: var(--color-muted); text-wrap: pretty; }
</style>
