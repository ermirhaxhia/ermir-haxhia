---
import Fletorja from '../../layouts/Fletorja.astro';
import PageHead from '../../components/PageHead.astro';
import Vlera from '../../components/Vlera.astro';
import { getKontaktet } from '../../lib/db';

const kontaktet = await getKontaktet();
---
<Fletorja title="Kontakt — Fletorja e Ermirit" current="/fletorja/kontakt" description="Si të kontaktosh Ermir Haxhian: GitHub, LinkedIn, email.">
  <PageHead etiketa="Fletorja · 03" titulli="Kontakt">
    Më gjen në këto vende.
  </PageHead>
  <section class="lista">
    {kontaktet.map((k) => (
      <div class="rresht">
        <span class="etiketa">{k.etiketa}</span>
        <span class="vlera"><Vlera v={k.vlera} href={k.url} /></span>
      </div>
    ))}
  </section>
</Fletorja>

<style>
  .lista { display: flex; flex-direction: column; margin-top: 64px; }
  .rresht { display: flex; flex-wrap: wrap; gap: 0 24px; min-height: 32px; }
  .etiketa { flex: 0 0 112px; font-family: var(--font-mono); font-size: 13px; line-height: 32px; color: var(--color-muted); }
  .vlera { font-size: 16px; line-height: 32px; color: var(--color-muted); }
  .vlera :global(a) { color: var(--color-ink); }
</style>
