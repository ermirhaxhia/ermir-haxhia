---
// Kryefaqja (design/pages/Kopertina.dc.html): hero me animacion, skena, rreth meje, kontakt.
import Base from '../layouts/Base.astro';
import Skena from '../components/Skena.astro';
import Vlera from '../components/Vlera.astro';
import { rrethMeje, kontaktet } from '../lib/content';

// Dizajni tregon vetëm këto tri te kryefaqja (Portfolio del te /fletorja/kontakt).
const kontaktKryefaqe = kontaktet.filter((k) => ['GitHub', 'LinkedIn', 'Email'].includes(k.etiketa));
const nav = [
  { href: '/fletorja', label: 'Fletorja' },
  { href: '/dosja', label: 'Dosja' },
  { href: '/libraria', label: 'Libraria' },
  { href: '#kontakt', label: 'Kontakt' },
];
---
<Base
  title="Ermir Haxhia"
  description="Punët, projektet dhe leximet e Ermir Haxhias: matematikë e aplikuar, të dhëna, kod."
>
  <div class="faqe">
    <header class="kolone">
      <a href="/" class="logo">Ermir Haxhia</a>
      <nav aria-label="Kryesore">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
    </header>

    <section class="hero kolone">
      <div class="tekst">
        <div class="late mono-etik">Matematikë e aplikuar · të dhëna · kod</div>
        <h1>
          <span class="maske"><span class="rise" style="animation-delay: 0.1s"><span class="hl">Ermir</span></span></span>
          <span class="maske"><span class="rise" style="animation-delay: 0.25s">Haxhia</span></span>
        </h1>
        <p class="late hyrje">Punët, projektet dhe leximet e mia, në tre hapësira. Hap njërën.</p>
        <div class="drop" style="animation-delay: 1.2s">
          <div class="ngjites">
            zgjidh një hapësirë
            <svg aria-hidden="true" width="56" height="30" viewBox="0 0 56 30" fill="none" stroke="#3A3320" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M2 6c14 2 30 4 44 16M36 20l10 3-4-10" /></svg>
          </div>
        </div>
      </div>
      <div class="skena-kolone">
        <Skena />
      </div>
    </section>

    <section id="rreth" class="seksion kolone">
      <div class="titull"><span class="nr">02</span><h2>Rreth meje</h2></div>
      <div class="trupi">
        <p class="rreth-teksti">{rrethMeje.teksti}</p>
        <div>
          {rrethMeje.fakte.map((f) => (
            <div class="rresht"><span class="etiketa">{f.etiketa}</span><span class="vlera"><Vlera v={f.vlera} /></span></div>
          ))}
        </div>
      </div>
    </section>

    <section id="kontakt" class="seksion kolone">
      <div class="titull"><span class="nr">03</span><h2>Kontakt</h2></div>
      <div>
        {kontaktKryefaqe.map((k) => (
          <div class="rresht"><span class="etiketa">{k.etiketa}</span><span class="vlera"><Vlera v={k.vlera} href={k.url} /></span></div>
        ))}
      </div>
    </section>

    <footer class="kolone">
      <span>© 2026 Ermir Haxhia</span>
      <span>www.ermir-haxhia.com</span>
    </footer>
  </div>
</Base>

<style>
  html { scroll-behavior: smooth; }
  .faqe {
    background-color: var(--color-desk);
    background-image: radial-gradient(ellipse 60% 55% at 68% 40%, rgba(255, 255, 255, 0.6), transparent 70%), radial-gradient(rgba(30, 34, 48, 0.07) 1px, transparent 1px);
    background-size: 100% 900px, 24px 24px;
    background-repeat: no-repeat, repeat;
  }
  .kolone { width: 100%; max-width: 1120px; margin: 0 auto; padding-left: clamp(16px, 4vw, 48px); padding-right: clamp(16px, 4vw, 48px); }

  header { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 24px; padding-top: 20px; padding-bottom: 12px; }
  .logo { display: inline-flex; align-items: center; min-height: 44px; font-size: 18px; font-weight: 650; letter-spacing: -0.02em; text-decoration: none; }
  nav { display: flex; flex-wrap: wrap; gap: 4px; }
  nav a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 14px; font-family: var(--font-mono); font-size: 13px; text-decoration: none; }

  .hero { padding-top: 40px; padding-bottom: 88px; display: flex; flex-wrap: wrap; align-items: center; gap: 56px clamp(32px, 5vw, 72px); position: relative; }
  .tekst { flex: 1 1 min(380px, 100%); min-width: 0; max-width: 520px; display: flex; flex-direction: column; gap: 28px; position: relative; z-index: 2; }
  .mono-etik { font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-muted-strong); }
  h1 { margin: 0; font-size: clamp(56px, 8.4vw, 112px); line-height: 1; font-weight: 700; letter-spacing: -0.04em; }
  .maske { display: block; overflow: hidden; padding-bottom: 0.04em; }
  .rise { display: block; animation: rise 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
  .hl { background: linear-gradient(#F7E58B, #F7E58B) no-repeat 0 92% / 0% 38%; animation: sweep 0.9s 1s ease forwards; }
  .hyrje { margin: 0; max-width: 440px; font-size: clamp(18px, 1.8vw, 21px); line-height: 1.55; text-wrap: pretty; }
  .late { animation: fade 0.8s 1.5s ease both; }
  .drop { align-self: flex-start; margin-top: 8px; animation: drop 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
  .ngjites {
    transform: rotate(-4deg); width: 176px; padding: 18px 18px 16px; background: var(--color-highlight);
    box-shadow: 0 16px 18px -12px rgba(30, 34, 48, 0.5); font-family: var(--font-hand); font-weight: 700;
    font-size: 28px; line-height: 30px; color: var(--color-sticky-ink); display: flex; flex-direction: column; gap: 6px;
  }
  .skena-kolone { flex: 1 1 min(480px, 100%); min-width: 0; max-width: 700px; margin-left: auto; position: relative; z-index: 1; }

  @keyframes rise { from { transform: translateY(108%); } to { transform: none; } }
  @keyframes sweep { from { background-size: 0% 38%; } to { background-size: 100% 38%; } }
  @keyframes fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes drop { from { opacity: 0; transform: translateY(-70px) scale(1.08); } to { opacity: 1; transform: none; } }

  .seksion {
    padding-top: 72px; padding-bottom: 72px; border-top: 1px solid var(--color-border);
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: 40px 64px; align-items: start;
  }
  #rreth { padding-bottom: 80px; }
  .titull { display: flex; align-items: baseline; gap: 16px; }
  .nr { font-family: var(--font-mono); font-size: 13px; color: var(--color-accent); }
  h2 { margin: 0; font-size: clamp(28px, 3.6vw, 40px); line-height: 1.15; font-weight: 650; letter-spacing: -0.025em; }
  .trupi { display: flex; flex-direction: column; gap: 28px; }
  .rreth-teksti { margin: 0; font-size: 20px; line-height: 32px; text-wrap: pretty; }
  .rresht { display: flex; flex-wrap: wrap; gap: 0 24px; min-height: 40px; }
  .etiketa { flex: 0 0 112px; font-family: var(--font-mono); font-size: 13px; line-height: 32px; color: var(--color-muted-strong); }
  .vlera { font-size: 18px; line-height: 32px; color: var(--color-muted-strong); }
  .vlera :global(a) { color: var(--color-ink); }

  footer { padding-top: 24px; padding-bottom: 40px; border-top: 1px solid var(--color-border); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; font-family: var(--font-mono); font-size: 12px; color: var(--color-muted-strong); }

  @media (prefers-reduced-motion: reduce) {
    .rise, .late, .drop { animation: none !important; }
    .hl { animation: none !important; background-size: 100% 38% !important; }
  }
</style>
