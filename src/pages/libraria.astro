---
// Libraria (design/pages/Libra.dc.html): rafte me kapakë libri dhe kartela e kurseve.
import Base from '../layouts/Base.astro';
import Vlera from '../components/Vlera.astro';
import Shigjeta from '../components/Shigjeta.astro';
import { getLibrat } from '../lib/db';

const librat = await getLibrat();

const nr = (i: number) => String(i + 1).padStart(2, '0');
// Etiketa e vogël mbi kapak: emri i rafit; raftet kraft mbajnë "Libër" (si në dizajn).
const etiketaKapakut = (r: (typeof librat.rafte)[number]) => (r.ngjyra === 'kraft' ? 'Libër' : r.titulli);

const kurse = librat.kurse;
const kurseHost = kurse.url ? new URL(kurse.url).host : null;
---
<Base title="Libraria — Ermir Haxhia" description="Librat për Python, R dhe lëndët e tjera, me statusin e leximit.">
  <div class="wrap">
    <div class="inner">
      <nav aria-label="Libraria" class="skedat">
        <a href="/" class="skeda">
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
          Kryefaqja
        </a>
      </nav>
      <main id="permbajtja">
        <section class="koka">
          <div class="etiketa">Libraria · Nr. 03</div>
          <h1><span class="hl">Libraria</span></h1>
          <p class="hyrje">Librat që mbaj për Python, R dhe lëndët e tjera, me statusin e leximit.</p>
        </section>

        {librat.rafte.map((r, i) => (
          <section class="raft">
            <div class="titull"><span class="nr">{nr(i)}</span><h2>{r.titulli}</h2></div>
            <div class="libra">
              {r.libra.map((l) => (
                <div class="libri">
                  <div class={`kapak ${r.ngjyra}`}>
                    <div class="kat">{etiketaKapakut(r)}</div>
                    <div class="titulli"><Vlera v={l.titulli} /></div>
                  </div>
                  <div class="info">
                    <div class="autori"><Vlera v={l.autori} /></div>
                    <div class="pilula-rresht">
                      <span class="pilule statusi">{l.statusi}</span>
                      {l.skedari
                        ? <a class="pilule" href={l.skedari}>{l.formati}</a>
                        : <span class="pilule">{l.formati}</span>}
                    </div>
                  </div>
                </div>
              ))}
            </div>
            <div class="bordi" aria-hidden="true"></div>
          </section>
        ))}

        <section class="raft">
          <div class="titull"><span class="nr">{nr(librat.rafte.length)}</span><h2>Kurse dhe fjalor</h2></div>
          <div class="kartela-trupi">
            <div class="flete-pas" aria-hidden="true"></div>
            <div class="flete-mes" aria-hidden="true"></div>
            {kurse.url ? (
              <a class="kartela" href={kurse.url} aria-label="Hap kurset">
                <div class="krye"><span class="nrk">Kartelë · Nr. {nr(librat.rafte.length)}</span><span class="adr">{kurseHost}</span></div>
                <div class="brenda">
                  <div class="k-titulli">{kurse.titulli}</div>
                  <div class="k-pershkrimi"><Vlera v={kurse.pershkrimi} /></div>
                  <div class="etiketat">{kurse.etiketat.map((e) => <span class="pilule">{e}</span>)}</div>
                  <span class="buton">Hap kurset <Shigjeta /></span>
                </div>
              </a>
            ) : (
              <div class="kartela">
                <div class="krye"><span class="nrk">Kartelë · Nr. {nr(librat.rafte.length)}</span><span class="adr"><Vlera v={null} /></span></div>
                <div class="brenda">
                  <div class="k-titulli">{kurse.titulli}</div>
                  <div class="k-pershkrimi"><Vlera v={kurse.pershkrimi} /></div>
                  <div class="etiketat">{kurse.etiketat.map((e) => <span class="pilule">{e}</span>)}</div>
                  <span class="buton joaktiv" aria-disabled="true">Hap kurset</span>
                </div>
              </div>
            )}
          </div>
        </section>
      </main>
    </div>
  </div>
</Base>

<style>
  .wrap { padding: 40px clamp(12px, 3vw, 32px) 64px; display: flex; flex-direction: column; align-items: center; }
  .inner { width: 100%; max-width: 1040px; display: flex; flex-direction: column; }

  .skedat { display: flex; }
  .skeda {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 18px; font-family: var(--font-mono);
    font-size: 13px; text-decoration: none; border: 1px solid var(--color-sage); border-bottom: none;
    border-radius: 10px 10px 0 0; background: var(--color-sage-light); color: var(--color-sage-ink);
  }
  .skeda:hover { color: var(--color-sage-ink); }

  main {
    width: 100%; background: var(--color-paper); border: 1px solid var(--color-sage); border-top: 3px solid var(--color-sage);
    border-radius: 0 12px 12px 12px; box-shadow: 0 18px 40px -24px rgba(30, 34, 48, 0.35); padding: 56px clamp(20px, 5vw, 64px) 72px;
  }

  .koka { display: flex; flex-direction: column; gap: 8px; }
  .etiketa { font-family: var(--font-mono); font-size: 13px; line-height: 32px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-muted); }
  h1 { margin: 0; font-size: clamp(34px, 5vw, 48px); line-height: 1.15; font-weight: 650; letter-spacing: -0.025em; }
  .hl { background: linear-gradient(transparent 58%, var(--color-highlight) 58%); }
  .hyrje { margin: 0; max-width: 580px; font-size: 18px; line-height: 30px; text-wrap: pretty; }

  .raft { display: flex; flex-direction: column; margin-top: 56px; }
  .titull { display: flex; align-items: baseline; gap: 16px; margin-bottom: 24px; }
  .nr { font-family: var(--font-mono); font-size: 13px; color: var(--color-accent); }
  h2 { margin: 0; font-size: 26px; line-height: 36px; font-weight: 650; letter-spacing: -0.02em; }

  .libra { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(168px, 100%), 168px)); gap: 28px; align-items: start; padding: 0 12px; }
  .libri { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .kapak {
    aspect-ratio: 3 / 4; background-image: repeating-linear-gradient(0deg, rgba(255,255,255,0.04) 0 1px, transparent 1px 3px);
    border-radius: 3px 8px 8px 3px; box-shadow: inset 8px 0 0 rgba(0, 0, 0, 0.22), 0 10px 14px -8px rgba(30, 34, 48, 0.6);
    padding: 18px 14px 14px 24px; display: flex; flex-direction: column; justify-content: space-between;
  }
  .kapak.navy { background-color: var(--color-navy); color: var(--color-navy-ink); }
  .kapak.sage { background-color: var(--color-sage); color: #fff; }
  .kapak.kraft { background-color: var(--color-kraft); color: var(--color-kraft-ink); }
  .kat { font-family: var(--font-mono); font-size: 11px; line-height: 16px; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.85; }
  .titulli { font-size: 17px; line-height: 22px; font-weight: 700; letter-spacing: -0.01em; }
  .titulli :global(.bosh) { color: inherit; }
  .info { display: flex; flex-direction: column; gap: 6px; }
  .autori { font-size: 14px; line-height: 20px; color: var(--color-muted); }
  .pilula-rresht { display: flex; flex-wrap: wrap; gap: 6px; }
  .pilule {
    font-family: var(--font-mono); font-size: 11px; line-height: 18px; padding: 0 8px; border: 1px solid var(--color-muted);
    border-radius: 999px; color: var(--color-muted-strong); text-decoration: none;
  }
  .pilule.statusi { border-color: var(--color-accent); color: var(--color-accent); }
  a.pilule { color: var(--color-accent); border-color: var(--color-accent); }
  .bordi { margin-top: 4px; height: 16px; background: linear-gradient(#C9A56E, #B8935A); border-radius: 2px; box-shadow: 0 10px 12px -8px rgba(30, 34, 48, 0.5); }

  .kartela-trupi { position: relative; max-width: 720px; margin-left: 12px; }
  .flete-pas, .flete-mes { position: absolute; inset: 0; border: 1px solid var(--color-border); border-radius: 4px; }
  .flete-pas { background: var(--color-paper-warm); transform: rotate(-1.6deg) translateY(6px); }
  .flete-mes { background: #fff; transform: rotate(1deg) translateY(3px); }
  .kartela {
    position: relative; display: flex; flex-direction: column; background: #fff; border: 1px solid #B9B4A8; border-radius: 4px;
    overflow: hidden; text-decoration: none; color: inherit; box-shadow: 0 14px 24px -16px rgba(30, 34, 48, 0.5);
  }
  .krye {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4px 16px; min-height: 44px;
    padding: 0 24px; border-bottom: 2px solid var(--color-index-red); font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em;
  }
  .nrk { color: var(--color-muted); text-transform: uppercase; }
  .adr { color: var(--color-accent); }
  .brenda {
    padding: 24px 24px 32px; background-image: linear-gradient(to bottom, transparent 31px, var(--color-rule) 31px);
    background-size: 100% 32px; background-repeat: repeat-y; background-position: 0 8px; display: flex; flex-direction: column;
  }
  .k-titulli { font-size: 26px; line-height: 32px; font-weight: 650; letter-spacing: -0.02em; }
  .k-pershkrimi { font-size: 16px; line-height: 32px; color: var(--color-muted); }
  .etiketat { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; min-height: 64px; }
  .etiketat .pilule { font-size: 12px; line-height: 20px; padding: 0 10px; }
  .buton {
    align-self: flex-start; display: inline-flex; align-items: center; gap: 12px; min-height: 44px; padding: 0 22px;
    background: var(--color-ink); color: var(--color-paper); border-radius: 8px; font-size: 15px; font-weight: 500;
  }
  .buton.joaktiv { opacity: 0.55; cursor: not-allowed; }
  a.kartela:hover { color: inherit; }
</style>
