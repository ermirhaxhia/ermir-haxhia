---
// Faqet e fshehura (shablloni i Projekt.dc.html): lexohen nga D1 sipas kodit në adresë.
// Pa lidhje nga faqet publike, noindex; kodi i gabuar jep 404 të zbrazët.
import ProjektFaqe from '../../components/ProjektFaqe.astro';
import { getFaqeFshehur } from '../../lib/db';

const { kodi } = Astro.params;
const faqe = kodi ? await getFaqeFshehur(kodi) : null;
if (!faqe) return Astro.rewrite('/404');

// Në SSR kokat vendosen këtu (nuk varemi nga public/_headers).
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('Cache-Control', 'private, no-store');
---
<ProjektFaqe
  title={faqe.titulli}
  noindex
  fshehur
  titulli={faqe.titulli}
  pershkrimi={faqe.pershkrimi}
  shinyUrl={faqe.shiny_url}
  raportiUrl={faqe.raporti_pdf_url}
/>
