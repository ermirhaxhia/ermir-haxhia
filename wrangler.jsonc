{
  // Worker-i i faqes (përputhet me projektin te Cloudflare që ndërton nga GitHub).
  "name": "ermir-haxhia",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": { "enabled": true },

  // Domeni (blerë te Cloudflare Registrar). Adresa kryesore është www; ermirhaxhia.com ridrejtohet
  // te www nga src/middleware.ts. Adresa *.workers.dev mbetet aktive.
  "routes": [
    { "pattern": "www.ermirhaxhia.com", "custom_domain": true },
    { "pattern": "ermirhaxhia.com", "custom_domain": true }
  ],
  // Skedarët (foto, PDF). Vetëm çelësat që fillojnë me "public/" shërbehen publikisht (shih src/pages/f/).
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "ermir-haxhia-files" }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ermir-haxhia-db",
      "database_id": "2935ea5c-49bd-4ca9-93ee-79acecc118b5",
      "migrations_dir": "migrations"
    }
  ]
}
