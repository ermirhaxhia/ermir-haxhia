{
  // Worker-i i faqes. Emri është i ndryshëm nga projektet e tjera në llogarinë Cloudflare.
  "name": "ermir-haxhia-site",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": { "enabled": true },
  // Skedarët (foto, PDF). Vetëm çelësat që fillojnë me "public/" shërbehen publikisht (shih src/pages/f/).
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "ermir-haxhia-files" }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ermir-haxhia-db",
      // PËRKOHËSISHT: id vendase për punë lokale. Zëvendësohet me id-në e vërtetë
      // kur krijohet baza te Cloudflare (M8, vetëm me konfirmim nga Ermiri).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
